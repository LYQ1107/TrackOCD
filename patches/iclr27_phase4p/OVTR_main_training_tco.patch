diff --git a/ovtr/models/tco.py b/ovtr/models/tco.py
index e69de29..79b3702 100644
--- a/ovtr/models/tco.py
+++ b/ovtr/models/tco.py
@@ -0,0 +1,37 @@
+"""Minimal trainable trajectory-conditioned objectness (TCO) head for OVTR.
+
+The head consumes OVTR-native persistent-query state only:
+  - current decoder image embedding (output_embedding_img)
+  - CIP/history-enriched query_tgt
+  - current objectness score
+  - disappear_time (survival state)
+
+It outputs one validity logit. During inference the logit is added to the
+current score in logit space for persistent (hit_count >= 1) queries only;
+new-object queries keep the original score.
+"""
+from __future__ import annotations
+
+import torch
+from torch import nn
+
+
+class TCOHead(nn.Module):
+    def __init__(self, d_model: int = 256, hidden: int = 128):
+        super().__init__()
+        self.net = nn.Sequential(
+            nn.Linear(d_model * 2 + 2, hidden),
+            nn.ReLU(inplace=True),
+            nn.Linear(hidden, hidden),
+            nn.ReLU(inplace=True),
+            nn.Linear(hidden, 1),
+        )
+        # initialize the final layer to a small output so TCO starts neutral.
+        nn.init.zeros_(self.net[-1].weight)
+        nn.init.zeros_(self.net[-1].bias)
+
+    def forward(self, cur_embed, hist_embed, score, disappear_time):
+        score = score.detach().float().unsqueeze(-1)
+        disappear_time = disappear_time.float().unsqueeze(-1)
+        x = torch.cat([cur_embed, hist_embed, score, disappear_time], dim=-1)
+        return self.net(x).squeeze(-1)
